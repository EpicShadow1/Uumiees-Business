{
  "name": "uumiees",
  "version": "1.0.0",
  "private": true,
  "description": "Uumiee's Business - Premium E-commerce Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "backend": "cd apps/backend && npm run dev",
    "web": "cd apps/web && npm run dev",
    "mobile": "cd apps/mobile && npm start"
  },
  "devDependencies": {
    "turbo": "^1.10.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0"
}
